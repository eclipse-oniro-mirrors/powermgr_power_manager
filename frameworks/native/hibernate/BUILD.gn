import("../../../powermgr.gni")

ohos_source_set("hibernate_callback_base") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  sources = [ "hibernate_callback_base.cpp" ]
  public_configs = [ ":hibernate_callback_base_config" ]
  configs = [ "${powermgr_utils_path}:coverage_flags" ]
  deps = [ "${powermgr_inner_api}:powermgr_client" ]
  external_deps = [
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
  subsystem_name = "powermgr"
  part_name = "${powermgr_part_name}"
}

config("hibernate_callback_base_config") {
  include_dirs = [ "." ]
}
