@!namespace("@ohos.power", "power")

@!sts_inject("""
static { loadLibraryWithPermissionCheck("power_manager_taihe_native.z", "@ohos.power") }""")

@!sts_inject("""
function throwParamError(): void {
    throw new _taihe_BusinessError(401, "Invalid input parameter.");
}

export function shutdown(reason: string, mode: InvokeMode): void | Promise<void> {
    if (mode == InvokeMode.SYNC) {
        return shutdown(reason);
    }
    if (mode != InvokeMode.ASYNC) {
        throwParamError();
    }
    return new Promise<void>((resolve, reject): void => {
        launch() {
            try {
                shutdown(reason);
                resolve(undefined);
            } catch (err) {
                reject(err as Error);
            }
        }
    });
}

export function reboot(reason: string, mode: InvokeMode): void | Promise<void> {
    if (mode == InvokeMode.SYNC) {
        return reboot(reason);
    }
    if (mode != InvokeMode.ASYNC) {
        throwParamError();
    }
    return new Promise<void>((resolve, reject): void => {
        launch() {
            try {
                reboot(reason);
                resolve(undefined);
            } catch (err) {
                reject(err as Error);
            }
        }
    });
}

export function wakeup(detail: string, mode: InvokeMode): void | Promise<void> {
    if (mode == InvokeMode.SYNC) {
        return wakeup(detail);
    }
    if (mode != InvokeMode.ASYNC) {
        throwParamError();
    }
    return new Promise<void>((resolve, reject): void => {
        launch() {
            try {
                wakeup(detail);
                resolve(undefined);
            } catch (err) {
                reject(err as Error);
            }
        }
    });
}

export function suspend(isImmediate: boolean | undefined, mode: InvokeMode): void | Promise<void> {
    if (mode == InvokeMode.SYNC) {
        return suspend(isImmediate);
    }
    if (mode != InvokeMode.ASYNC) {
        throwParamError();
    }
    return new Promise<void>((resolve, reject): void => {
        launch() {
            try {
                suspend(isImmediate);
                resolve(undefined);
            } catch (err) {
                reject(err as Error);
            }
        }
    });
}""")

union MyUndefined { @undefined Undefined; }

function Shutdown(reason: String): void;

function Reboot(reason: String): void;

function IsActive(): bool;

function Wakeup(detail: String): void;

function Suspend(isImmediate: Optional<bool>): void;

function GetPowerMode(): DevicePowerMode;

 @gen_async("setPowerMode")
 @gen_promise("setPowerMode")
 function SetPowerModeSync(mode: DevicePowerMode): void;

 function GetPowerSubMode(): DevicePowerSubMode;

 @gen_promise("setPowerMode")
 function SetPowerSubModeSync(mode: DevicePowerMode, @optional subMode: Optional<DevicePowerSubMode>): void;

function IsStandby(): bool;

function Hibernate(clearMemory: bool): void;

function SetScreenOffTime(timeout: i64): void;

function RefreshActivity(reason: String): void;

function SetPowerKeyFilteringStrategy(strategy: PowerKeyFilteringStrategy): void;

function GetPowerConfig(sceneName: String): String;

function SetPowerConfig(sceneName: String, configVal: String): void;

function RegisterShutdownCallback(shutdownCb: (isReboot: bool) => void): void;

function UnregisterShutdownCallback(callBack: Optional<(arg: MyUndefined) => void>): void;

enum DevicePowerMode : i32 {
  MODE_NORMAL = 600,
  MODE_POWER_SAVE,
  MODE_PERFORMANCE,
  MODE_EXTREME_POWER_SAVE,
  MODE_CUSTOM_POWER_SAVE = 650
}

enum DevicePowerSubMode : i32 {
  SUB_MODE_INVALID = -1,
  SUB_MODE_SUPER_POWER_SAVE = 603001,
  SUB_MODE_EMERGENCY = 603002
}

enum PowerKeyFilteringStrategy : i32 {
  DISABLE_LONG_PRESS_FILTERING = 0,
  LONG_PRESS_FILTERING_ONCE = 1
}

enum InvokeMode : i32 {
  SYNC = 0,
  ASYNC = 1
}